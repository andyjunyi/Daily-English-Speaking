    {
      "id": "ultimate-roast",
      "title": "強烈反制",
      "subtitle": "警告 / 威脅 / 終極蔑視",
      "phrases": [
        { "id": "roast-01", "en": "Or what?", "zh": "不然你想怎樣？", "tags": ["反制","挑釁"], "level": "beginner" },
