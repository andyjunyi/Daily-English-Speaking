        { "id": "roast-04", "en": "For who?", "zh": "給誰？對誰而言？", "tags": ["反制","質疑"], "level": "beginner" },
        { "id": "roast-05", "en": "Did I hit a nerve?", "zh": "你急了？我戳到痛處了？", "tags": ["反制","諷刺"], "level": "intermediate" },
        { "id": "roast-06", "en": "What's that supposed to mean?", "zh": "你這是什麼意思？", "tags": ["反制","質疑"], "level": "intermediate" },
        { "id": "roast-07", "en": "Where are your manners?", "zh": "你禮貌嗎？", "tags": ["反制","譴責"], "level": "intermediate" },
        { "id": "roast-08", "en": "Who made you the boss?", "zh": "你說了算？你算哪根蔥？", "tags": ["反制","強硬"], "level": "intermediate" },
        { "id": "roast-09", "en": "You better think carefully.", "zh": "你最好想清楚。", "tags": ["反制","威脅"], "level": "intermediate" },
        { "id": "roast-10", "en": "I'm not doing this with you.", "zh": "我沒空陪你鬧。", "tags": ["反制","冷漠"], "level": "intermediate" },
        { "id": "roast-11", "en": "Do I owe you something?", "zh": "我欠你的嗎？", "tags": ["反制","強硬"], "level": "intermediate" },
        { "id": "roast-12", "en": "Who are you trying to impress?", "zh": "裝什麼裝？演給誰看？", "tags": ["反制","諷刺"], "level": "intermediate" },
        { "id": "roast-13", "en": "Don't touch me!", "zh": "別碰我！", "tags": ["反制","身體"], "level": "beginner" },
        { "id": "roast-14", "en": "You think you're slick?", "zh": "你以為你耍小聰明沒人看出來？", "tags": ["反制","諷刺"], "level": "intermediate" },
        { "id": "roast-15", "en": "You're playing with fire.", "zh": "你在玩火。", "tags": ["反制","威脅"], "level": "intermediate" },
        { "id": "roast-16", "en": "Go ahead, make my day.", "zh": "有種你就試試看。", "tags": ["反制","挑釁"], "level": "advanced" },
        { "id": "roast-17", "en": "And you think you matter?", "zh": "你算哪根蔥？", "tags": ["反制","蔑視"], "level": "advanced" },
        { "id": "roast-18", "en": "Don't say I didn't warn you.", "zh": "我話先說在前頭。", "tags": ["反制","威脅"], "level": "intermediate" },
        { "id": "roast-19", "en": "Let's keep it professional.", "zh": "公事公辦。", "tags": ["反制","職場"], "level": "intermediate" }
      ]
